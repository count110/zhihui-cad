# API Key 仅保存在本机 .env；部署包不包含用户密钥。
ZHIHUI_AGENT_MODE=multi
ZHIHUI_LLM=real
ZHIHUI_LLM_PRIMARY=deepseek
ZHIHUI_LLM_BACKUP=qwen
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-10-18 实测可用；可按平台可用型号调整
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
QWEN_MODEL=
ZHIHUI_MCP=stdio
ZHIHUI_MCP_EXTENDED=1
ZHIHUI_WORKERS=2
# 可选：每角色 <ROLE> 为 ROUTER/PLANNER/KNOWLEDGE/EDITOR/REPAIRER/REPORTER
# ZHIHUI_<ROLE>_PROVIDER=deepseek
# ZHIHUI_<ROLE>_MODEL=
# 可选视觉审查：模型须支持图片输入
# ZHIHUI_VL_PROVIDER=
# ZHIHUI_VL_MODEL=
