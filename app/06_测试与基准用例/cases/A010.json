{
 "id": "A010",
 "category": "A",
 "functions": [
  "manage_dynamic_block"
 ],
 "note": "动态块 = 每组参数值对应一个静态块变体（AutoCAD 里看到的是静态块，见功能对照表）",
 "prompt": "给块PLATE加一个宽度参数，默认100，把这个块参照的宽度设成140",
 "prompt_asr": "给块PLATE加一个宽度参数，默认一百，把这个块参照的宽度设成一百四十",
 "intents": [
  "block_xref_constraint"
 ],
 "setup": {
  "template": "blank_a3",
  "calls": [
   {
    "tool": "draw_polygons_and_meshes",
    "args": {
     "shape_type": "rectangle",
     "corner1": "0,0",
     "width": 100,
     "height": 60
    }
   },
   {
    "tool": "create_and_insert_block",
    "args": {
     "action": "define_block",
     "block_name": "PLATE",
     "source_entity_ids": [
      "PL1"
     ],
     "base_point": "0,0",
     "keep_source": "convert"
    }
   }
  ]
 },
 "steps": [
  {
   "tool": "manage_dynamic_block",
   "args": {
    "action": "create_dynamic_def",
    "block_name": "PLATE",
    "parameters_and_actions": [
     {
      "param_name": "宽",
      "param_type": "linear_stretch",
      "geometry_refs": [
       "E1"
      ],
      "axis": "x",
      "default_value": 100
     }
    ]
   }
  },
  {
   "rec": "块参照"
  },
  {
   "tool": "manage_dynamic_block",
   "args": {
    "action": "set_dynamic_property",
    "block_ref_id": "$s2.entity_ids[0]",
    "property_overrides": {
     "宽": 140
    }
   }
  }
 ],
 "assert": [
  {
   "variant_block": {
    "prefix": "PLATE@",
    "max_x": 140
   }
  }
 ],
 "mock_ok": false
}
