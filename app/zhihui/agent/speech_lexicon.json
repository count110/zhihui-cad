 "regex": [
  {
   "pattern": "(?<=[个大小同各画])源(?![头泉])",
   "repl": "圆",
   "note": "源→圆（画个源、小源）"
  },
  {
   "pattern": "(?<=[个大小同各画])园(?!林|区|地)",
   "repl": "圆",
   "note": "园→圆（画个园）"
  },
  {
   "pattern": "(?<=\\d)\\s*(?:源|园)",
   "repl": "圆",
   "note": "数字后的 源/园→圆"
  },
  {
   "pattern": "(?<=\\d)的(?:源|园)(?![头泉林区地])",
   "repl": "的圆",
   "note": "数字后的“的源”→的圆（直径40的源）"
  },
  {
   "pattern": "(?:fai|phi|PHI|Fai|FAI|斐|菲|费)\\s*(?=\\d)",
   "repl": "⌀",
   "note": "fai/斐 三十 → ⌀30"
  },
  {
   "pattern": "正负\\s*(?=\\d)",
   "repl": "±",
   "note": "正负0.1 → ±0.1"
  },
  {
   "pattern": "加减\\s*(?=\\d)",
   "repl": "±",
   "note": "加减0.1 → ±0.1"
  },
  {
   "pattern": "(\\d)\\s*逗号\\s*(?=-?\\d)",
   "repl": "\\1,",
   "note": "逗号 → ,"
  },
  {
   "pattern": "(\\d)\\s*[,，]\\s*(?=-?\\d)",
   "repl": "\\1,",
   "note": "全角逗号 → ,"
  },
  {
   "pattern": "(?:相对|艾特|at|AT)\\s*(?=-?\\d)",
   "repl": "@",
   "note": "相对/艾特 → @"
  },
  {
   "pattern": "(\\d)\\s*(?:小于|角度|夹角)\\s*(?=-?\\d)",
   "repl": "\\1<",
   "note": "100 小于 45 → 100<45（极坐标）"
  },
  {
   "pattern": "零零(?!\\d)",
   "repl": "0,0",
   "note": "零零 → 0,0"
  },
  {
   "pattern": "(?<![A-Za-z])([RrHh])\\s+(?=\\d)",
   "repl": "\\1",
   "note": "R 20 → R20"
  },
  {
   "pattern": "桶体(?!积)",
   "repl": "筒体",
   "note": "桶体→筒体（设备图；桶体积不改）"
  },
  {
   "pattern": "人空(?!间)",
   "repl": "人孔",
   "note": "人空→人孔（设备图；人空间不改）"
  }
 ],
